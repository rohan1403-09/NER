PORT=4000
ENV=development
# Generate: python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=
ADMIN_API_KEY=
# Frontend origins allowed to call the API (comma separated)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# SMS / OTP provider: console | twilio | msg91
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_ALERT_TEMPLATE_ID=

# Nominatim requires an identifying User-Agent with contact info
GEOCODER_USER_AGENT=TrailSense/1.0 (you@example.com)

# IMD: verify the URL and your city id on mausam.imd.gov.in
IMD_CITY_URL=https://city.imd.gov.in/api/cityweather_loc.php?id=
IMD_DEFAULT_CITY_ID=42182

# Auto monitor: checks every registered user's area for landslide risk
MONITOR_ENABLED=true
MONITOR_INTERVAL_MIN=30
